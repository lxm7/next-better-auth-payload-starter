# Auth
BETTER_AUTH_SECRET="your-better-auth-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# DB
DATABASE_URL="your-database-url"

# Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend
RESEND_API_KEY="your-resend-api-key"
EMAIL_SENDER_NAME="Your App Name"
EMAIL_SENDER_ADDRESS="noreply@send.yourdomain.com"

# Payload (CMS)
# Signs Payload's editor sessions. Generate with `openssl rand -hex 32`.
PAYLOAD_SECRET="your-payload-secret"
# The `cms` database on the same Neon branch as DATABASE_URL, connecting as
# the `payload_cms` role (no access to `neondb`). Use Neon's pooled host
# (`-pooler` in the hostname) so serverless instances share connections.
CMS_DATABASE_URL="postgresql://payload_cms:<password>@<endpoint>-pooler.<region>.aws.neon.tech/cms?sslmode=require"

# Hygraph (CMS, being replaced by Payload)
HYGRAPH_ENDPOINT="https://<region>.hygraph.com/v2/<projectId>/master"
HYGRAPH_TOKEN="your-hygraph-read-only-token"
