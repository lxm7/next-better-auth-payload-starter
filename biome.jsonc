{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/next", "ultracite/react"],
  "files": {
    "includes": [
      "!public",
      "!components/ui",
      "!hooks/use-mobile.ts",
      "!.source",
      // Drizzle writes these: the SQL, the journal and the snapshots are
      // regenerated by `db:generate`, so formatting them is undone on the
      // next schema change.
      "!migrations",
      // Payload writes these: the import map is rewritten on every dev boot
      // (in its own style, under a filename it fixes), and the types and
      // migrations come from `payload generate:types` / `migrate:create`.
      "!app/(payload)/admin/importMap.js",
      "!cms/payload-types.ts",
      "!cms/migrations"
    ]
  }
}
